# ==============================================================================
# LogiSphere AI - Web Portal Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - All variables prefixed with `VITE_` are publicly accessible in the client browser.
# - NEVER put backend secrets here (e.g., GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   JWT_SECRET, or Database passwords).
# - Backend secrets belong exclusively in `backend/.env`.
# ==============================================================================

# Centralized Express Backend API URL (without trailing slash)
# Local development default: http://localhost:5001
# Production deployment: https://logisphereai.onrender.com
VITE_API_BASE_URL=http://localhost:5001

# Real-Time WebSocket Base URL (ws:// or wss://)
# Local development default: ws://localhost:5001
# Production deployment: wss://logisphereai.onrender.com
VITE_WS_URL=ws://localhost:5001

# Application branding title
VITE_APP_TITLE=LogiSphere AI Management Portal

